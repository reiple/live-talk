# docker compose / npm run ai:up 설정 예시. 필요하면 .env 로 복사해서 수정한다.

# 사용할 로컬 LLM: ollama | vllm
LLM_PROVIDER=ollama

# Ollama 모델 (https://ollama.com/library)
OLLAMA_MODEL=qwen3:8b

# vLLM 모델 (Hugging Face 모델 이름). 8GB GPU 에서는 4B 압축(AWQ) 모델부터 권장
VLLM_MODEL=Qwen/Qwen3-4B-AWQ
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEM=0.85

# 직접 지정하면 공급자 기본값보다 우선 (보통 비워 둠)
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_EXTRA_BODY={"reasoning_effort":"none"}
# LLM_TIMEOUT_MS=20000

# 캐릭터 음성 (TTS). 비우면 음성을 끄고 효과음으로 진행
# TTS_BASE_URL=http://tts:8880/v1
# TTS_VOICE=KR
