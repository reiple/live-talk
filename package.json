{
  "name": "live-talk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p server/tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run tests server/tests",
    "test:e2e": "playwright test",
    "server": "node server/src/index.ts",
    "ai:up": "docker compose --profile ${LLM_PROVIDER:-ollama} up -d --build",
    "ai:down": "docker compose --profile ollama --profile vllm --profile web down",
    "ai:logs": "docker compose logs -f api"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
